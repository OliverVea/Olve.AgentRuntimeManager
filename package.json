{
  "name": "olve-arm",
  "private": true,
  "type": "module",
  "description": "Workspace root: TypeSpec contract tooling, generated clients, frontend and CLI.",
  "workspaces": [
    "src/frontend",
    "src/cli",
    "src/codegen/typespec-arm-csharp"
  ],
  "scripts": {
    "spec": "tsp compile src/spec/main.tsp",
    "client": "openapi-ts -f openapi-ts.config.mjs",
    "generate": "npm run spec && npm run client",
    "codegen:test": "npm test --workspace src/codegen/typespec-arm-csharp"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@jdxcode/mise": "2026.9.13",
    "@typespec/compiler": "1.16.0",
    "@typespec/http": "1.16.0",
    "@typespec/openapi": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "bun@1.4.2": true,
    "@jdxcode/mise@2026.9.13": true
  }
}
