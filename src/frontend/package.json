{
  "name": "arm-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vanilla Web Components + TypeScript frontend for Olve.AgentRuntimeManager",
  "scripts": {
    "generate": "npm --prefix ../.. run generate",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
