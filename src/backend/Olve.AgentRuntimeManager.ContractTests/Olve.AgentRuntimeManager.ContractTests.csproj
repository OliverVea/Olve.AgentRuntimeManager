<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract tests: run the API in-process (WebApplicationFactory) and check it against the
    TypeSpec contract compiled to artifacts/spec/openapi.json. On by default; opt out with
    -p:RunContractTests=false.
  -->
  <PropertyGroup>
    <IsTestProject Condition="'$(RunContractTests)' == 'false'">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(RunContractTests)' == 'false'">false</IsTestingPlatformApplication>
    <OutputType Condition="'$(RunContractTests)' == 'false'">Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepoRoot>
    <OpenApiSpecFile>$(RepoRoot)artifacts/spec/openapi.json</OpenApiSpecFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Olve.AgentRuntimeManager/Olve.AgentRuntimeManager.csproj" />
  </ItemGroup>

  <!--
    The API project's build compiles the spec (its GenerateArmApi target writes
    artifacts/spec/openapi.json alongside the generated C#), so it exists once project references
    are resolved; it doesn't at evaluation time on a clean checkout, hence the target.
  -->
  <Target Name="IncludeContractSpec" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths"
          Condition="'$(RunContractTests)' != 'false'">
    <ItemGroup>
      <None Include="$(OpenApiSpecFile)" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
