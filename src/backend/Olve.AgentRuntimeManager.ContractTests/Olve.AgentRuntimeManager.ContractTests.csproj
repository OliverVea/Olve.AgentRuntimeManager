<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract tests: run the API in-process (WebApplicationFactory) and check it against the
    TypeSpec contract compiled to artifacts/spec/openapi.json. On by default; opt out (including
    the Node-dependent spec compile) with -p:RunContractTests=false.
  -->
  <PropertyGroup>
    <IsTestProject Condition="'$(RunContractTests)' == 'false'">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(RunContractTests)' == 'false'">false</IsTestingPlatformApplication>
    <OutputType Condition="'$(RunContractTests)' == 'false'">Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepoRoot>
    <OpenApiSpecFile>$(RepoRoot)artifacts/spec/openapi.json</OpenApiSpecFile>
  </PropertyGroup>

  <ItemGroup>
    <SpecInput Include="$(RepoRoot)src/spec/**/*.tsp;$(RepoRoot)tspconfig.yaml;$(RepoRoot)package.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Olve.AgentRuntimeManager/Olve.AgentRuntimeManager.csproj" />
  </ItemGroup>

  <!-- Compile main.tsp → artifacts/spec/openapi.json (skipped when the spec is up to date). -->
  <Target Name="CompileContractSpec"
          BeforeTargets="BeforeBuild"
          Condition="'$(RunContractTests)' != 'false'"
          Inputs="@(SpecInput)"
          Outputs="$(OpenApiSpecFile)">
    <Exec Command="npm run spec" WorkingDirectory="$(RepoRoot)" />
    <!-- tsp leaves the file untouched when unchanged; touch it so the target stays incremental. -->
    <Touch Files="$(OpenApiSpecFile)" />
  </Target>

  <!-- The spec does not exist at evaluation time on a clean checkout, so add it after compiling. -->
  <Target Name="IncludeContractSpec" AfterTargets="CompileContractSpec" BeforeTargets="AssignTargetPaths"
          Condition="'$(RunContractTests)' != 'false'">
    <ItemGroup>
      <None Include="$(OpenApiSpecFile)" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
