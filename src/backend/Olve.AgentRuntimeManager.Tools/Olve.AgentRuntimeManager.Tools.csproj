<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ARM's tools (M10): an internal executable shipped next to ARM, never part of the API or the
    `arm` CLI. The agent starts it per session as a stdio MCP server. Native AOT on publish, so
    it's one file that keeps running when a deploy prunes its release folder. ARM references it
    for the catalog and launch contract (Protocol/).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>olve-arm-tools</AssemblyName>
    <RootNamespace>Olve.AgentRuntimeManager.Tools</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The supervisor's POSIX helpers (Protocol/Posix.cs): a reference, not a linked copy, since
         ARM references both and a public type in two assemblies would be ambiguous there. -->
    <ProjectReference Include="../Olve.AgentRuntimeManager.Supervisor/Olve.AgentRuntimeManager.Supervisor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Olve.AgentRuntimeManager.UnitTests" />
  </ItemGroup>

</Project>
