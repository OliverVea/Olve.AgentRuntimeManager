<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject Condition="'$(RunUnitTests)' == 'false'">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(RunUnitTests)' == 'false'">false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Olve.Results.TUnit" />
    <PackageReference Include="Rocks" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Sessions/Claude/Stub/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Sessions/Supervision/Stub/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tool-call gist cases the web UI is tested against too (ToolGistTests). -->
    <None Include="../../frontend/src/sessions/tool-gist.cases.json" Link="Sessions/Activities/tool-gist.cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Olve.AgentRuntimeManager/Olve.AgentRuntimeManager.csproj" />
    <!-- ARM's tools (M10): its internals, and the olve-arm-tools apphost next to the tests. -->
    <ProjectReference Include="../Olve.AgentRuntimeManager.Tools/Olve.AgentRuntimeManager.Tools.csproj" />
  </ItemGroup>

</Project>
