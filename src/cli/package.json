{
  "name": "arm-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "arm — command-line client for Olve.AgentRuntimeManager",
  "scripts": {
    "generate": "npm --prefix ../.. run generate",
    "prebuild": "npm run generate",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit -p .",
    "test": "npx bun test",
    "start": "npx bun src/main.ts",
    "build": "npx bun build src/main.ts --compile --minify --outfile ../../artifacts/cli/arm",
    "prebuild:all": "npm run generate",
    "build:all": "npm run build:linux-x64 && npm run build:linux-arm64 && npm run build:darwin-arm64",
    "build:linux-x64": "npx bun build src/main.ts --compile --minify --target=bun-linux-x64 --outfile ../../artifacts/cli/arm-linux-x64",
    "build:linux-arm64": "npx bun build src/main.ts --compile --minify --target=bun-linux-arm64 --outfile ../../artifacts/cli/arm-linux-arm64",
    "build:darwin-arm64": "npx bun build src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile ../../artifacts/cli/arm-darwin-arm64"
  }
}
