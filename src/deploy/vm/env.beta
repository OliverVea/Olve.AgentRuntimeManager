# Non-secret app config for the beta VM (what the former Helm chart's beta values set).
# Written to /etc/olve-arm/env inside the VM by vm-deploy.sh.
Host=0.0.0.0
Port=5000
Auth__Authority=https://auth-beta.ovea.pro/application/o/olve-arm/
Auth__Audience=olve-arm
Auth__Frontend__Authority=https://auth-beta.ovea.pro/application/o/olve-arm-spa/
Auth__Frontend__ClientId=olve-arm-spa
Logging__LogLevel__Olve.AgentRuntimeManager.Auth=Debug
Logging__LogLevel__Microsoft.AspNetCore.Authentication=Debug
# Beta OTLP is unauthenticated (Tailscale); empty OAuth2 settings disable the token provider.
OpenTelemetry__Endpoint=http://otel-beta.ovea.pro
OpenTelemetry__Protocol=http
OpenTelemetry__OAuth2__TokenUrl=
OpenTelemetry__OAuth2__ClientId=
# Sessions live in SQLite (OPEN-QUESTIONS A5); systemd creates /var/lib/olve-arm (StateDirectory),
# outside the release folders a deploy replaces.
ConnectionStrings__Arm=Data Source=/var/lib/olve-arm/arm.db
# Each Claude session's working directory and raw output (OPEN-QUESTIONS A10), next to the database.
Providers__Claude__WorkRoot=/var/lib/olve-arm/sessions
# The release's own Claude Code (the bundle's claude-code step, linked by vm-deploy.sh); its token
# is appended from a pipeline secret.
Providers__Claude__Command=/opt/olve-arm/current/claude
# The per-session supervisors' sockets (gentle restart, docs/GENTLE-RESTART.md): the service's
# RuntimeDirectory, kept across restarts. The supervisor itself is found next to ARM.
Supervisor__SocketRoot=/run/olve-arm/supervisors
# Agents (and their supervisors) run as their own unprivileged user, not as arm (docs/AGENT-USER.md;
# the user, its sudoers rule and the shared folders come from vm-deploy.sh).
Supervisor__User=arm-agent
