{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/check.sh --hook",
            "timeout": 900,
            "statusMessage": "Running the pipeline gate's checks for what changed before pushing"
          }
        ]
      }
    ]
  }
}
